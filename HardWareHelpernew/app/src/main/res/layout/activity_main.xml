<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/main_background"

    android:padding="24dp">

    <!-- IC翻翻看 -->

    <ImageButton
        android:id="@+id/btnMemoryGame"

        android:layout_width="300dp"
        android:layout_height="150dp"

        android:layout_marginTop="70dp"

        android:src="@drawable/ic_memory_cover"

        android:scaleType="fitCenter"

        android:background="@android:color/transparent"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 電阻值選擇題 -->

    <ImageButton
        android:id="@+id/btnQuiz"

        android:layout_width="300dp"
        android:layout_height="150dp"

        android:layout_marginTop="48dp"

        android:src="@drawable/resistor_quiz_cover"

        android:scaleType="fitCenter"

        android:background="@android:color/transparent"

        app:layout_constraintTop_toBottomOf="@id/btnMemoryGame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- IC / 感測器圖鑑 -->

    <ImageButton
        android:id="@+id/btnEncyclopedia"

        android:layout_width="300dp"
        android:layout_height="150dp"

        android:layout_marginTop="48dp"

        android:src="@drawable/encyclopedia_cover"

        android:scaleType="fitCenter"

        android:background="@android:color/transparent"

        app:layout_constraintTop_toBottomOf="@id/btnQuiz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>